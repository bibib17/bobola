# =========================================================
# APACHE & INFINITYFREE HOSTING CONFIGURATION
# BolaBola League - PWA & Web Game Optimization
# =========================================================

# 1. MIME Types untuk PWA, Font & Aset Web
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .manifest
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType font/woff2 .woff2
</IfModule>

# 2. Aktifkan CORS (Cross-Origin Resource Sharing)
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# 3. Kompresi Gzip untuk Loading Cepat
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# 4. Cache Control Aset Statis
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# 5. Keamanan & Proteksi File Sensitif
<FilesMatch "(\.env|\.git|database\.sql|composer\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

DirectoryIndex index.html index.php
